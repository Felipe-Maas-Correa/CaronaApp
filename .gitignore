# ── Configuração sensível (Firebase, chave PIX) ──────────────
# Copie js/config.example.js para js/config.js e preencha.
js/config.js

# ── Firebase (cache local do deploy) ─────────────────────────
.firebase/

# Variáveis de ambiente
.env
.env.*
!.env.example

# ── Dependências ─────────────────────────────────────────────
node_modules/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Sistema operacional ──────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editores / IDEs ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── Chaves de service account (NUNCA versionar) ──────────────
# A chave-mestra do Firebase. Ela vai para os secrets do Worker
# (wrangler secret put), não para um arquivo do repositório.
*serviceaccount*.json
*service-account*.json
sa.json
*-firebase-adminsdk-*.json

# Relatorio de auditoria de seguranca (NAO versionar — contem exploits)
docs/

# ── Config local do Claude Code (launch.json do preview) ─────
.claude/
